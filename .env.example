# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_APP_ID=
# Opcional, para registrar los comandos al instante en tu servidor
DISCORD_GUILD_ID=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=low

# Ruta completa a tu bóveda de Obsidian, y la carpeta dentro de ella donde se guardan las campañas
OBSIDIAN_VAULT=/home/usuario/Documentos/MiBoveda
OBSIDIAN_FOLDER=DnD
