# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_APP_ID=
# Opcional, para registrar los comandos al instante en tu servidor
DISCORD_GUILD_ID=

# Gemini (https://aistudio.google.com/apikey). Creala en un proyecto SIN facturación para que sea 100% gratis
GEMINI_API_KEY=
# Modelos en orden, separados por coma: si se acaba la cuota gratuita de uno, se usa el siguiente
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_THINKING=low

# Ruta completa a tu bóveda de Obsidian, y la carpeta dentro de ella donde se guardan las campañas
OBSIDIAN_VAULT=/home/usuario/Documentos/MiBoveda
OBSIDIAN_FOLDER=DnD
