# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_APP_ID=
# Opcional, para registrar los comandos al instante en tu servidor
DISCORD_GUILD_ID=

# Gemini (https://aistudio.google.com/apikey). Creala en un proyecto SIN facturación para que sea 100% gratis
GEMINI_API_KEY=
# Narrador: modelos en orden, separados por coma. Si se acaba la cuota gratuita de uno, se usa el siguiente
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Tareas livianas (resúmenes, /ooc, /importar), para no gastar la cuota del narrador
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_THINKING=low
# Opcional: los límites diarios (RPD) de tu cuenta, de https://aistudio.google.com/rate-limit, para que /cuota diga cuánto queda
# GEMINI_LIMITS=gemini-3.8-flash=250,gemini-3.5-flash-lite=1000,gemini-3.1-flash-lite=1000

# Ollama (modelo local, gratis y sin límite): árbitro de tiradas, y narrador de respaldo si se acaba Gemini
OLLAMA_MODEL=gemma4:e4b
OLLAMA_URL=http://127.0.0.1:11434
# "false" para que Ollama NO narre cuando se acaba Gemini (el árbitro lo sigue usando)
OLLAMA_FALLBACK=true

# Ruta completa a tu bóveda de Obsidian, y la carpeta dentro de ella donde se guardan las campañas
OBSIDIAN_VAULT=/home/usuario/Documentos/MiBoveda
OBSIDIAN_FOLDER=DnD
