{
  "name": "dnd-dm-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute dnd-dm --remote --file=schema.sql",
    "db:migrate": "wrangler d1 execute dnd-dm --remote --file=migrations/0002_fichas_nivel20.sql",
    "register": "node scripts/register-commands.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "unpdf": "^1.8.1"
  }
}
